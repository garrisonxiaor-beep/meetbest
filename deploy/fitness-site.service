# Managed by fitness-site deploy/install.sh
[Unit]
Description=Fitness knowledge website
After=network.target

[Service]
Type=simple
User=fitness-site
Group=fitness-site
WorkingDirectory=/opt/fitness-site/current
EnvironmentFile=/opt/fitness-site/shared/fitness.env
ExecStart=@NODE_BIN@ /opt/fitness-site/current/server/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fitness-site
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
